{
  "language": "russian",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "WebSearch",
      "Edit",
      "Write"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/architecture/tools/hook.py\" pre-edit",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/architecture/tools/hook.py\" pre-shell",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/architecture/tools/hook.py\" post-edit",
            "timeout": 60,
            "statusMessage": "Проверяю md карты и собираю его страницу"
          }
        ]
      }
    ]
  }
}
